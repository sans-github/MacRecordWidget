{
  "permissions": {
    "allow": [
      "Bash(git.*)",
      "Bash(gh.*)",
      "Bash(unzip.*)",
      "Bash(open.*)",
      "Bash(xattr.*)",
      "Bash(cp.*)",
      "Bash(pkill.*)",
      "Bash(pdfinfo.*)",
      "Bash(command -v.*)",
      "Bash(pbpaste)",
      "Bash(pandoc.*)",
      "Bash(mkdir.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/mock-kit-check.sh"
          }
        ]
      }
    ]
  }
}
